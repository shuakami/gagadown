+++ b/crates/gagadown-core/src/lang.rs
@@ -0,0 +1,178 @@
+//! Minimal bilingual UI strings: Simplified Chinese plus English.
+//!
+//! Call sites keep the Chinese literal as the lookup key — `tr("下载")` —
+//! so the diff stays mechanical. `tr` returns the Chinese text on zh
+//! locales and the English entry on any other locale; missing entries
+//! fall back to the key itself, so the table can grow incrementally.
+
+use serde::{Deserialize, Serialize};
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Lang {
+    Zh,
+    En,
+}
+
+/// Persisted language preference (`Settings::language`); `Auto` follows the
+/// system locale.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum LangPref {
+    #[default]
+    Auto,
+    Zh,
+    En,
+}
+
+static DETECTED: OnceLock<Lang> = OnceLock::new();
+/// 0 = follow system, 1 = zh, 2 = en.
+static PREF: AtomicU8 = AtomicU8::new(0);
+
+fn detected() -> Lang {
+    *DETECTED.get_or_init(|| match sys_locale::get_locale() {
+        Some(l) if l.to_lowercase().starts_with("zh") => Lang::Zh,
+        _ => Lang::En,
+    })
+}
+
+/// Apply a preference change; takes effect on the next `tr`/`trf` call.
+pub fn set_pref(pref: LangPref) {
+    let v = match pref {
+        LangPref::Auto => 0,
+        LangPref::Zh => 1,
+        LangPref::En => 2,
+    };
+    PREF.store(v, Ordering::Relaxed);
+}
+
+pub fn lang() -> Lang {
+    match PREF.load(Ordering::Relaxed) {
+        1 => Lang::Zh,
+        2 => Lang::En,
+        _ => detected(),
+    }
+}
+
+/// Translate a user-facing string. `zh` doubles as the lookup key.
+pub fn tr(zh: &'static str) -> &'static str {
+    match lang() {
+        Lang::Zh => zh,
+        Lang::En => en(zh),
+    }
+}
+
+/// Translate a template and substitute `{0}`, `{1}`, … with the matching
+/// `args` entry, so English word order may differ from the Chinese key.
+/// Pre-render non-`Display` formatting (e.g. `format!("{:.1}", v)`) and
+/// pass the result — `{i:spec}` is not supported.
+pub fn trf(zh: &'static str, args: &[&dyn std::fmt::Display]) -> String {
+    let mut s = tr(zh).to_string();
+    for (i, a) in args.iter().enumerate() {
+        let indexed = format!("{{{i}}}");
+        if s.contains(&indexed) {
+            s = s.replace(&indexed, &a.to_string());
+        } else {
+            s = s.replacen("{}", &a.to_string(), 1);
+        }
+    }
+    s
+}
+
+fn en(zh: &'static str) -> &'static str {
+    match zh {
+        // error.rs — ErrorKind::label
+        "网络连接失败" => "Network connection failed",
+        "连接超时" => "Connection timed out",
+        "TLS 握手失败" => "TLS handshake failed",
+        "服务器限流" => "Server rate-limited",
+        "服务器错误" => "Server error",
+        "认证失败或链接已过期" => "Authentication failed or link expired",
+        "文件不存在" => "File not found",
+        "服务器不支持分段" => "Server does not support ranges",
+        "远端文件已变化" => "Remote file changed",
+        "磁盘空间不足" => "Not enough disk space",
+        "文件读写错误" => "File I/O error",
+        "已取消" => "Cancelled",
+        "不是下载链接" => "Not a download link",
+        "GaGaDown 已在运行" => "GaGaDown is already running",
+        "未知错误" => "Unknown error",
+        // error.rs — brief()
+        "域名解析失败" => "DNS resolution failed",
+        "连接被拒绝" => "Connection refused",
+        "连接被重置" => "Connection reset",
+        "证书无效" => "Invalid certificate",
+        "连接意外断开" => "Connection closed unexpectedly",
+        // error.rs — summary() templates
+        "{0}（HTTP {1}）" => "{0} (HTTP {1})",
+        "{0}（{1}）" => "{0} ({1})",
+        // config.rs — ProxyMode::label
+        "默认直连，失败自动走代理" => "Direct first, fall back to proxy on failure",
+        "仅直连" => "Direct only",
+        "优先代理，失败回退直连" => "Proxy first, fall back to direct on failure",
+        "仅代理" => "Proxy only",
+        // route.rs — route names and errors
+        "直连" => "Direct",
+        "代理地址无效 {0}: {1}" => "Invalid proxy address {0}: {1}",
+        "代理 {0}" => "Proxy {0}",
+        "本机代理 {0}" => "Local proxy {0}",
+        "环境变量代理 {0}" => "Env proxy {0}",
+        "系统代理" => "System proxy",
+        "没有可用线路（仅代理模式但未配置或探测到代理）" => "No route available (proxy-only mode with no proxy configured or detected)",
+        "没有可用线路" => "No route available",
+        // api.rs — browser hand-off messages
+        "下载" => "download",
+        "这是网页播放器生成的视频流，没有可以直接下载的文件地址" => "This is a video stream generated by the web player; there is no direct file URL to download",
+        "不支持这种链接，只能下载 http/https 地址" => "Unsupported link; only http/https URLs can be downloaded",
+        "服务器拒绝访问（{0}）" => "Server refused access ({0})",
+        "文件不存在（{0}）" => "File not found ({0})",
+        "连接超时，{0} 秒内服务器没有响应" => "Connection timed out: no server response within {0} seconds",
+        "这个地址打开的是网页，不是文件" => "This URL opens a web page, not a file",
+        // download.rs — log lines and errors
+        "服务器分段异常，切换单线程" => "Server range handling failed; switching to a single connection",
+        "远端文件已变化，重新下载" => "Remote file changed; restarting the download",
+        "线路 {0}，响应 {1} ms" => "Route {0}, response {1} ms",
+        "服务器返回的是网页，不是文件" => "Server returned a web page, not a file",
+        "远端文件已变化，从头下载" => "Remote file changed; restarting from the beginning",
+        "需要 {0} MB，可用 {1} MB" => "Need {0} MB, only {1} MB available",
+        "下载已停止" => "Download stopped",
+        "SHA-256 不一致: {0}" => "SHA-256 mismatch: {0}",
+        "校验失败" => "Checksum failed",
+        "SHA-256 校验通过" => "SHA-256 verified",
+        "部分分段未完成" => "Some segments did not finish",
+        "线路切换 {0} -> {1}" => "Route switched {0} -> {1}",
+        "连接 #{0} {1}，第 {2} 次重试" => "Connection #{0}: {1}; retry {2}",
+        "等待响应超时" => "Timed out waiting for a response",
+        "Content-Range 起点 {0} != {1}" => "Content-Range starts at {0}, expected {1}",
+        "If-Range 未命中" => "If-Range check failed",
+        "服务器忽略 Range" => "Server ignored the Range header",
+        "读取超时" => "Read timed out",
+        "连接提前关闭" => "Connection closed early",
+        "从 {0} MB 处续传" => "Resuming at {0} MB",
+        "服务器不支持续传，从头下载" => "Server does not support resume; starting over",
+        "长度不符 {0}/{1}" => "Length mismatch {0}/{1}",
+        "{0}，第 {1} 次重试" => "{0}; retry {1}",
+        // engine.rs — notices, log lines and errors
+        "下载完成 {0}" => "Download complete: {0}",
+        "失败: {0}" => "Failed: {0}",
+        "下载失败 {0}: {1}" => "Download failed {0}: {1}",
+        "GaGaDown 已在运行：{0}" => "GaGaDown is already running: {0}",
+        "无法安全访问系统密钥环，GaGaDown 未读取任务记录：{0}" => "Could not access the system keyring securely; GaGaDown did not read task records: {0}",
+        "无法创建浏览器插件配对密钥：{0}" => "Could not create the browser extension pairing key: {0}",
+        "任务记录解密失败：{0}" => "Failed to decrypt task records: {0}",
+        "任务记录格式无效：{0}" => "Invalid task record format: {0}",
+        "无法加密旧任务记录：{0}" => "Could not encrypt legacy task records: {0}",
+        "自动重试（第 {0} 次）" => "Auto-retry (attempt {0})",
+        "任务记录加密失败：{0}" => "Failed to encrypt task records: {0}",
+        "链接无效: {0}" => "Invalid URL: {0}",
+        "只支持 http/https 链接" => "Only http/https URLs are supported",
+        "已从浏览器续上新链接" => "Refreshed the link from the browser",
+        "正在等待磁盘操作结束，结束后将自动继续；无需再次点击" => "Waiting for disk operations to finish; will continue automatically — no need to click again",
+        "删除失败，已恢复任务以便重试: {0}" => "Delete failed; the task was restored for retry: {0}",
+        "删除失败: {0}" => "Delete failed: {0}",
+        "任务仍在运行" => "Task is still running",
+        "已从最近删除恢复" => "Restored from recently deleted",
+        _ => zh,
+    }
+}
